<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - STORYTELLER</title>
    <link rel="stylesheet" href="styles.css"> <!-- ลิงก์ไปที่ไฟล์ CSS -->
</head>
<body>

    <header>
        <h1 class="logo">STORYTELLER</h1>
        <nav>
            <a href="/" class="nav-link">HOME</a>
            <a href="/genre" class="nav-link">GENRE</a>
        </nav>
    </header>

    <main>
        <div class="login-container">
            <div class="login-modal">
                <h2 class="login-title">LOGIN</h2>
                <form action="/login" method="POST">
                    <div class="input-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" required>
                    </div>

                    <div class="input-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" required>
                    </div>

                    <button type="submit" class="login-btn">LOGIN</button>

                    <div class="register-link-container">
                        <span>Don't have an account?</span>
                        <a href="/register" class="register-link">Register here</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2025 STORYTELLER</p>
    </footer>

</body>
</html>
