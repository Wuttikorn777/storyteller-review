<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - STORYTELLER</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #1a1a1a;
            color: white;
            height: 100%;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background-color: #111;
            border-bottom: 2px solid #ff69b4;
        }

        .logo {
            font-size: 2rem;
            font-weight: 700;
            color: #ff69b4;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-size: 1.2rem;
            font-weight: 500;
        }

        nav a:hover {
            color: #ff69b4;
        }

        /* Login Section */
        .login-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #333;
            height: 100vh; 
        }

        .login-modal {
            background-color: rgba(0, 0, 0, 0.9);
            padding: 30px;
            border-radius: 10px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.7);
            border: 3px solid #ff69b4;
        }

        .login-title {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 20px;
            color: #ff69b4;
            font-family: 'Montserrat', sans-serif;
        }

        .input-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 1rem;
            margin-bottom: 5px;
            color: white;
            font-weight: 500;
        }

        input {
            width: 100%;
            padding: 12px;
            font-size: 1rem;
            background-color: #444;
            color: white;
            border: 2px solid #555;
            border-radius: 5px;
            margin-bottom: 10px;
            transition: 0.3s ease;
        }

        input:focus {
            background-color: #555;
            border-color: #ff69b4;
            outline: none;
        }

        button.login-btn {
            width: 100%;
            padding: 12px;
            font-size: 1.2rem;
            background-color: #ff69b4;
            border: none;
            border-radius: 5px;
            color: white;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.3s;
        }

        button.login-btn:hover {
            background-color: #e2589e;
            transform: scale(1.05);
        }

        .register-link-container {
            text-align: center;
            margin-top: 10px;
        }

        .register-link {
            color: #ff69b4;
            text-decoration: none;
            font-weight: 500;
        }

        .register-link:hover {
            text-decoration: underline;
        }

        footer {
            text-align: center;
            padding: 20px;
            background-color: #222;
            border-top: 2px solid #ff69b4;
        }

        footer p {
            margin: 0;
            color: white;
        }

    </style>
</head>
<body>

    <header>
        <h1 class="logo">STORYTELLER</h1>
        <nav>
            <a href="/" class="nav-link">HOME</a>
            <a href="/genre" class="nav-link">GENRE</a>
        </nav>
    </header>

    <main>
        <div class="login-container">
            <div class="login-modal">
                <h2 class="login-title">LOGIN</h2>
                <form action="/login" method="POST">
                    <div class="input-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" placeholder="Enter your username" required>
                    </div>

                    <div class="input-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Enter your password" required>
                    </div>

                    <button type="submit" class="login-btn">LOGIN</button>

                    <div class="register-link-container">
                        <span>Don't have an account?</span>
                        <a href="/register" class="register-link">Register here</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2025 STORYTELLER</p>
    </footer>

</body>
</html>
