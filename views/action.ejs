<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Action Movies</title>
  <link href="https://fonts.googleapis.com/css2?family=Lobster&family=Roboto:wght@300;400&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #111;
      color: white;
      text-align: left;
      padding: 20px;
    }
    h1 {
      font-family: 'Lobster', cursive;
      font-size: 3rem;
      margin-bottom: 10px;
    }
    .movie-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .movie {
      background: #222;
      border-radius: 5px;
      text-align: center;
      padding: 0;
      overflow: hidden;
    }
    .movie img {
      width: 100%;
      height: auto;
      object-fit: cover;
      display: block;
      border-radius: 5px 5px 0 0;
    }
    .ratings {
      color: gold;
      margin-top: 10px;
      font-size: 1.2rem;
    }
    .back-button {
      text-decoration: none;
      color: white;
      padding: 10px 20px;
      border-radius: 20px;
      background: #222;
      border: 2px solid pink;
      transition: 0.3s;
      display: inline-block;
      margin-bottom: 20px;
      font-size: 1.5rem; 
      font-weight: bold;
    }
    .back-button:hover {
      background: pink;
      color: black;
    }
    .back-button:active {
    background: pink;
    color: black;
    }
  </style>
</head>
<body>

  <div class="container">
    <a href="/" class="back-button">GENRE</a>
<div class="container">
    <a href="/genre" class="back-button">GENRE</a>
    <h1>Action Movies</h1>

    <div class="movie-list">
      <div class="movie">
        <img src="https://i0.wp.com/jediyuth.com/wp-content/uploads/2024/12/Ballerina_Poster_Thai-version.jpg?w=1000&ssl=1" alt="Ballerina">
        <h3>Ballerina</h3>
        <p>Ratings: ⭐⭐⭐⭐</p>
      </div>
      <div class="movie">
        <img src="https://www.siamzone.com/movie/pic/2024/badboysrideordie/poster1.jpg" alt="Bad Boys: Ride or Die">
        <h3>Bad Boys: Ride or Die</h3>
        <p>Ratings: ⭐⭐⭐⭐</p>
      </div>
    </div>
  </div>

</body>
</html>
