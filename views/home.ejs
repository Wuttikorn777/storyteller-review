<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homepage - STORYTELLER</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <header>
        <h1 class="logo">STORYTELLER</h1>
        <nav>
            <a href="/" class="nav-link">HOME</a>
            <a href="/index.ejs" class="nav-link">GENRE</a>
        </nav>
    </header>

    <main>
        <section class="hero-section">
            <div class="slider-container">
                <div class="slider">
                    <img src="https://static.wikia.nocookie.net/jaws/images/3/3b/Jaws_blu-ray_movie_1.jpg/revision/latest?cb=20131122124857" alt="Jaws Movie Poster">
                    <img src="https://cdn.theplaylist.net/wp-content/uploads/2023/05/08064650/Oppenheimer-Christopher-Nolan.jpg">
                    <img src="https://i.ytimg.com/vi/CHkSXqKYElo/hq720.jpg?sqp=-oaymwEhCK4FEIIDSFryq4qpAxMIARUAAAAAGAElAADIQj0AgKJD&rs=AOn4CLCtStBQgmIYTtTrvogmIUVnyPMFqw">
                </div>
                <!-- จุดบ่งชี้ (dots) -->
                <div class="dots-container">
                    <span class="dot active"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </div>
            </div>
        </section>

        <section class="genres">
            <div class="genre-container">
                <h2 class="genre-title">GENRES</h2>
                <a href="#" class="genre-button active">Action</a>
                <a href="#" class="genre-button">Comedy</a>
                <a href="#" class="genre-button">Drama</a>
                <a href="#" class="genre-button">Fantasy</a>
                <a href="#" class="genre-button">Horror</a>
            </div>
        </section>

        <section class="movies">
            <div class="movie-posters">
                <div class="movie-poster">
                    <img src="https://static.wikia.nocookie.net/ultimatepopculture/images/3/39/Shrek.jpg/revision/latest?cb=20210311141139" alt="Shrek" class="poster-img">
                    <p>Shrek</p>
                </div>
                <div class="movie-poster">
                    <img src="https://m.media-amazon.com/images/I/71KPOvu-hOL._AC_SL1351_.jpg" alt="Joker" class="poster-img">
                    <p>Joker</p>
                </div>
            </div>
        </section>
    </main>
    
    <footer>
        <p>&copy; 2025 STORYTELLER</p>
    </footer>

    <!-- Link to external JS file at the end of the body -->
    <script src="script.js"></script> 

</body>
</html>
