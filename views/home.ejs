<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homepage - STORYTELLER</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
          box-sizing: border-box;
        }
        body {
          font-family: 'Poppins', sans-serif;
          background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
          color: white;
          margin: 0;
          padding: 0;
        }
        header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 20px 40px;
          background-color: #111;
          border-bottom: 2px solid #ff69b4;
          box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        .logo {
          font-size: 2.5rem;
          font-weight: bold;
          color: #ff69b4;
        }
        nav a {
          color: white;
          text-decoration: none;
          margin-left: 30px;
          font-size: 1.2rem;
          position: relative;
        }
        nav a:hover {
          color: #ff69b4;
        }
        .slider-container {
          position: relative;
          width: 100%;
          max-width: 700px;
          height: 625px;
          margin: 40px auto;
          overflow: hidden;
          border-radius: 20px;
          box-shadow: 0 8px 20px rgba(0,0,0,0.6);
        }
        .slider {
          display: flex;
          transition: none; /* ปิดตอนโหลด */
        }
        .slider-item {
          min-width: 100%;
          display: flex;
        }
        .video-container {
          display: flex;
          width: 100%;
          background-color: #222;
        }
        .video-thumbnail {
          width: 60%;
          position: relative;
        }
        .video-thumbnail img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
        .play-button {
          position: absolute;
          bottom: 15px;
          right: 15px;
          width: 45px;
          height: 45px;
          background-color: rgba(255,105,180,0.8);
          border-radius: 50%;
          color: white;
          font-size: 1.2rem;
          display: flex;
          align-items: center;
          justify-content: center;
          text-decoration: none;
          transition: background 0.3s ease;
          border: none;
        }
        .play-button:hover {
          background-color: rgba(230, 0, 126, 0.9);
        }
        .video-info {
          width: 40%;
          padding: 20px;
          background-color: rgba(0, 0, 0, 0.6);
          display: flex;
          flex-direction: column;
          justify-content: center;
          position: relative;
        }
        .video-info h2 {
          font-size: 1.4rem;
          color: #ff69b4;
          margin-bottom: 10px;
        }
        .video-info p {
          font-size: 1rem;
          margin-bottom: 10px;
        }
        .dots-container {
          display: flex;
          justify-content: center;
          margin-top: 15px;
        }
        .dot {
          width: 12px;
          height: 12px;
          margin: 0 6px;
          background-color: #888;
          border-radius: 50%;
          cursor: pointer;
        }
        .dot.active {
          background-color: #ff69b4;
        }
        .prev, .next {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          background-color: rgba(0,0,0,0.5);
          color: white;
          border: none;
          font-size: 2rem;
          padding: 10px 15px;
          cursor: pointer;
          z-index: 100;
        }
        .prev { left: 10px; }
        .next { right: 10px; }
    
        .genres, .movies {
          text-align: center;
          margin: 50px 0;
        }
        .genre-container {
          display: inline-block;
          padding: 20px;
          background-color: #2a2a2a;
          border-radius: 15px;
        }
        .genre-title {
          font-size: 2.2rem;
          color: #ff69b4;
          margin-bottom: 20px;
        }
        .genre-button {
          display: inline-block;
          margin: 5px;
          padding: 10px 20px;
          background-color: #444;
          border-radius: 8px;
          color: white;
          text-decoration: none;
          font-size: 1rem;
        }
        .genre-button:hover, .genre-button.active {
          background-color: #ff69b4;
        }
        .movie-posters {
  display: grid;
  grid-template-columns: repeat(4, 1fr); /* 4 คอลัมน์ในแถว */
  gap: 20px; /* ระยะห่างระหว่างภาพยนตร์ */
  justify-items: center;
  padding: 20px;
}

.movie-poster {
  width: 300px; /* ขยายขนาดของโปสเตอร์ */
  height: 550px; /* ขยายขนาดของโปสเตอร์ */
  border-radius: 12px; /* ทำมุมให้โค้ง */
  overflow: hidden; /* ป้องกันภาพเบียดออกนอกกรอบ */
  object-fit: cover;
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5); /* เพิ่มเงาให้ภาพ */
  transition: transform 0.3s ease-in-out, box-shadow 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  background-color: #222; /* เพิ่มพื้นหลังให้กับโปสเตอร์ */
}

.movie-poster img {
  width: 100%;
  height: 100%;
}

.movie-poster p {
  text-align: center;
  font-size: 1.2rem;
  color: white;
  font-weight: bold;
  margin: 15px 0;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.movie-poster:hover {
  transform: scale(1.05);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5); /* เพิ่มเงาเมื่อ hover */
}



        .movie-link {
          text-decoration: none;  /* ลบขีดใต้ของลิงก์ */
          color: inherit;         /* ให้ลิงก์ใช้สีของข้อความปกติ */
        }

        .movie-link p {
          color: white;  /* กำหนดสีให้กับชื่อภาพยนตร์เพื่อให้แน่ใจว่าสีข้อความเป็นปกติ */
        }

        footer {
          background-color: #111;
          padding: 20px;
          text-align: center;
          border-top: 2px solid #ff69b4;
        }
        footer p {
          color: white;
          margin: 0;
        }
      </style>
</head>
<body>

