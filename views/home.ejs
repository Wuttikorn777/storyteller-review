                    </div>

                    <!-- เพิ่ม Slider อีกสไลด์ -->
                    <div class="slider-item">
                        <div class="video-container">
                          <div class="video-thumbnail">
                            <img src="https://m.media-amazon.com/images/M/MV5BNGY1YjBiNzMtYWZhNC00OWViLWE0MzItNjc4YzczOGNiM2I0XkEyXkFqcGc@._V1_FMjpg_UX1000_.jpg" alt="Adolescence">
