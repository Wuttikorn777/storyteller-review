<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Movie Reviews</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #111;
      color: white;
      text-align: center;
    }
    .container {
      max-width: 1000px;
      margin: auto;
      padding: 20px;
    }
    .navbar {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 20px;
    }
    .navbar a {
      text-decoration: none;
      color: white;
      padding: 10px 20px;
      border-radius: 5px;
      background: #222;
    }
    .navbar a.active {
      background: pink;
      color: black;
    }
    .movie-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .movie {
      background: #222;
      padding: 10px;
      border-radius: 5px;
      box-shadow: 0 0 5px rgba(255, 255, 255, 0.1);
    }
    .movie img {
      width: 100%;
      border-radius: 5px;
    }
    .ratings {
      color: gold;
      margin-top: 5px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Storyteller</h1>
    <div class="navbar">
      <a href="#">Action</a>
      <a href="#" class="active">Comedy</a>
      <a href="#">Drama</a>
      <a href="#">Fantasy</a>
      <a href="#">Horror</a>
    </div>
    
    <div class="movie-list">
      <div class="movie">
        <img src="https://via.placeholder.com/200x300" alt="Ballerina">
        <h3>Ballerina</h3>
        <p>Ratings: ⭐⭐⭐⭐</p>
      </div>
      <div class="movie">
        <img src="public/image/BadBoy2024.jpg" alt="Bad Boys: Ride or Die">
        <h3>Bad Boys: Ride or Die</h3>
        <p>Ratings: ⭐⭐⭐⭐</p>
      </div>
      <div class="movie">
        <img src="https://via.placeholder.com/200x300" alt="Road House">
        <h3>Road House</h3>
        <p>Ratings: ⭐⭐⭐</p>
      </div>
      <div class="movie">
        <img src="https://via.placeholder.com/200x300" alt="Fall Guy">
        <h3>Fall Guy</h3>
        <p>Ratings: ⭐⭐⭐⭐</p>
      </div>
    </div>
  </div>
</body>
</html>

