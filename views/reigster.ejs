<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - STORYTELLER</title>
    <link rel="stylesheet" href="styles.css"> <!-- ลิงก์ไปที่ไฟล์ CSS -->
</head>
<body>

    <header>
        <h1 class="logo">STORYTELLER</h1>
        <nav>
            <a href="/" class="nav-link">HOME</a>
            <a href="/genre" class="nav-link">GENRE</a>
        </nav>
    </header>

    <main>
        <div class="register-container">
            <div class="register-modal">
                <h2 class="register-title">REGISTER</h2>
                <form action="/register" method="POST">
                    <div class="input-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" required>
                    </div>

                    <div class="input-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div class="input-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" required>
                    </div>

                    <div class="input-group">
                        <label for="confirm-password">Confirm Password</label>
                        <input type="password" id="confirm-password" name="confirm-password" required>
                    </div>

                    <button type="submit" class="register-btn">REGISTER</button>

                    <div class="back-to-login-container">
                        <span>Already have an account?</span>
                        <a href="/login" class="back-to-login">Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2025 STORYTELLER</p>
    </footer>

</body>
</html>

