<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Horror Movies</title>
  <link href="https://fonts.googleapis.com/css2?family=Lobster&family=Roboto:wght@300;400&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #111;
      color: white;
      text-align: left;
      padding: 20px;
    }
    h1 {
      font-family: 'Lobster', cursive;
      font-size: 3rem;
      margin-bottom: 10px;
    }
    .movie-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .movie {
      background: #222;
      border-radius: 5px;
      text-align: center;
      padding: 0;
      overflow: hidden;
    }
    .movie img {
      width: 100%;
      height: auto;
      object-fit: cover;
      display: block;
      border-radius: 5px 5px 0 0;
    }
    .ratings {
      color: gold;
      margin-top: 10px;
      font-size: 1.2rem;
    }
    .back-button {
      text-decoration: none;
      color: white;
      padding: 10px 20px;
      border-radius: 20px;
      background: #222;
      border: 2px solid pink;
      transition: 0.3s;
      display: inline-block;
      margin-bottom: 20px;
      font-size: 1.5rem; 
      font-weight: bold;
    }
    .back-button:hover {
      background: pink;
      color: black;
    }
    .back-button:active {
    background: pink;
    color: black;
    }
  </style>
</head>
<body>

<div class="container">
    <a href="/genre" class="back-button">GENRE</a>
    <h1>Horror Movies</h1>

    <div class="movie-list">
      <div class="movie">
        <img src="https://scontent.fbkk29-1.fna.fbcdn.net/v/t39.30808-6/482000592_1533367107584002_8924514609620022598_n.jpg?_nc_cat=100&ccb=1-7&_nc_sid=127cfc&_nc_eui2=AeFudZYrSa79OoCiYR9aH7tW54d3Lrr6baLnh3cuuvptohLUA8j-64YmKb2BeeX4pNpgzvT5jJtnJzx2tOZlgCwK&_nc_ohc=9JFLoE5Zu6MQ7kNvgHfeOM0&_nc_oc=AdlmGU9yfEjGz6lvB_HpgNK3hOgKyMCMQfARGwL82RJjfrawwuKkRWxHuINwDm2zYjIl2Nc13A68q8kCF4vtL6-t&_nc_zt=23&_nc_ht=scontent.fbkk29-1.fna&_nc_gid=nA_-4CJntnQVnew_4QBxYw&oh=00_AYH_JR92vbVFwn-f5xKsVcTz1X_t5ZBdQjsU-L9fp2BbNw&oe=67EAC2EB" alt="Nosferatu">
        <h3>Nosferatu</h3>
        <p>Ratings: ⭐⭐⭐</p>
      </div>
      <div class="movie">
        <img src="https://scontent.fbkk29-5.fna.fbcdn.net/v/t39.30808-6/484505368_1064155409078465_6577906682143342680_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=127cfc&_nc_eui2=AeHrF2ruN45E1R3EgQCcgFA8pXeAzUlvIAOld4DNSW8gA3GNOxv553CsCpKImL6lEBdW0mrz_FQbiXyRHGPGmMgz&_nc_ohc=dG-n0vgjCuQQ7kNvgEkmLHr&_nc_oc=Admu8vBBFKtMePNgEH_2BoHAugW7FIjbxlFRJ_EGrsvaWpiLmIizFqWjuxFqWIS36o0XTuCPyHgsQDMFxpMinnA6&_nc_zt=23&_nc_ht=scontent.fbkk29-5.fna&_nc_gid=wHHiUrhTuPxWjgaVnUqTHw&oh=00_AYE7lLssG-OCXW02Q_RxJdaIPhLNFg0NBPFamSOKSnpRrA&oe=67EAEC70" alt="พนอ">
        <h3>พนอ</h3>
        <p>Ratings: ⭐⭐⭐</p>
      </div>
    </div>
  </div>

</body>
</html>