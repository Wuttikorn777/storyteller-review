<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Movie Reviews</title>
  <link href="https://fonts.googleapis.com/css2?family=Lobster&family=Roboto:wght@300;400&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #111;
      color: white;
      text-align: left;
      padding: 20px;
    }
    header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 20px 40px;
          background-color: #111;
          border-bottom: 2px solid #ff69b4;
          box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }
    nav a:hover {
          color: #ff69b4;
    }
    nav a {
          color: white;
          text-decoration: none;
          margin-left: 30px;
          font-size: 1.2rem;
          position: relative;
    }
    h1 {
      font-family: 'Lobster', cursive;
      font-size: 3rem;
      margin-bottom: 10px;
    }
    /* จัด GENRE และปุ่มเป็นแถวเดียวกัน */
    .genre-container {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }
    .genre-title {
      color: pink;
      font-size: 1.5rem;
      font-weight: bold;
    }
    .genre-button {
      text-decoration: none;
      color: white;
      padding: 10px 20px;
      border-radius: 20px;
      background: #222;
      font-weight: 500;
      border: 2px solid transparent;
      transition: 0.3s;
    }
    .genre-button:hover {
      border-color: pink;
    }
    .genre-button.active {
      background: pink;
      color: black;
      border-color: pink;
    }
    .movie-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .movie {
  background: #222;
  border-radius: 5px;
  box-shadow: 0 0 5px rgba(255, 255, 255, 0.1);
  text-align: center;
  padding: 0;
  overflow: hidden;
}

.movie img {
  width: 100%;
  height: auto; /* ให้รักษาสัดส่วนของรูป */
  object-fit: cover; /* รูปจะพอดีกับกรอบโดยไม่ผิดสัดส่วน */
  display: block;
  border-radius: 5px 5px 0 0;
}

.ratings {
  color: gold;
  margin-top: 10px; /* เพิ่ม margin ให้พอเหมาะ */
  font-size: 1.2rem; /* ให้ขนาดของตัวอักษรใหญ่ขึ้นถ้าต้องการ */
}
  </style>
</head>

<body>
  <header>
    <nav>
        <a href="/home" class="nav-link">HOME</a>
        <a href="/bookmarks" class="view-bookmarks-btn">My Bookmarks</a>
    </nav>
  </header>

  <div class="container">
    <h1>Storyteller</h1>
    
    <!-- GENRE และปุ่มอยู่แถวเดียวกัน -->
    <div class="genre-container">
      <div class="genre-title">GENRE</div>
      <a href="/action" class="genre-button">Action</a>
      <a href="comedy" class="genre-button">Comedy</a>
      <a href="drama" class="genre-button">Drama</a>
      <a href="horror" class="genre-button">Horror</a>
    </div>

    <div class="movie-list">
