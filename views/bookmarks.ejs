<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookmarks - STORYTELLER</title>
    <style>
        body {
            background: #121212;
            color: white;
            font-family: Arial, sans-serif;
            text-align: center;
        }
        .bookmark-list {
            list-style: none;
            padding: 0;
        }
        .bookmark-list li {
            background: #222;
            margin: 10px;
            padding: 10px;
            border-radius: 5px;
        }
        .remove-btn {
            background-color: red;
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
        }
        .back-btn {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 15px;
            background: #ff69b4;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }
    </style>
</head>
<body>

   
    <h1>My Bookmarks</h1>
    <h2>Welcome, <%= currentUser %>!</h2>
    <p id="user-info"></p>
    <ul id="bookmark-list" class="bookmark-list"></ul>
    <a href="/home" class="back-btn">⬅ Back to Home</a>
    <script>  
      let currentUser = "<%= currentUser %>";

function getUserBookmarks() {
    return JSON.parse(localStorage.getItem(`bookmarks_${currentUser}`)) || [];
}

function saveUserBookmarks(bookmarks) {
    localStorage.setItem(`bookmarks_${currentUser}`, JSON.stringify(bookmarks));
} 
    document.addEventListener("DOMContentLoaded", function () {
        loadBookmarks();
      });
      
      function loadBookmarks() {
        let bookmarkList = document.getElementById("bookmark-list");
        let bookmarks = JSON.parse(localStorage.getItem("bookmarks")) || [];
      
        if (bookmarks.length === 0) {
            bookmarkList.innerHTML = "<p>No bookmarks yet.</p>";
            return;
        }
      
        bookmarkList.innerHTML = ""; // เคลียร์ค่าก่อนโหลดใหม่
      
        bookmarks.forEach((movie, index) => {
            let listItem = document.createElement("li");
            listItem.innerHTML = `
                <img src="${movie.poster}" alt="${movie.title}" width="250">
                <h3>${movie.title}</h3>
                 <button class="remove-btn" onclick="removeBookmark(${index})">Remove</button>
                `;
            bookmarkList.appendChild(listItem);
        });
      }
      </script>
<script>
    function addBookmark(title, poster) {
        let bookmarks = getUserBookmarks();
        if (!bookmarks.some(b => b.title === title)) {
            bookmarks.push({ title, poster });
            saveUserBookmarks(bookmarks);
        }
        loadBookmarks();
    }

    function removeBookmark(index) {
            let bookmarks = JSON.parse(localStorage.getItem('bookmarks')) || [];
            bookmarks.splice(index, 1);
            localStorage.setItem('bookmarks', JSON.stringify(bookmarks));
            loadBookmarks();
        }

        window.onload = loadBookmarks;


</script>



</body>
</html>