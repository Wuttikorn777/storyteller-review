<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - STORYTELLER</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            margin: 0;
            padding: 0;

            background-color: #1a1a1a;
            color: white;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background-color: #111;
            border-bottom: 2px solid #ff69b4;
        }

        .logo {
            font-size: 2rem;
            font-weight: 700;
            color: #ff69b4;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-size: 1.2rem;
            font-weight: 500;
        }

        nav a:hover {
            color: #ff69b4;
        }

        /* Register Section */
        .register-form {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #333;
        }

        .register-container {
            background-color: rgba(0, 0, 0, 0.9);
            padding: 30px; /* ลด padding */
            border-radius: 10px; /* ลดความโค้งมุม */
            width: 100%;
            max-width: 400px; /* ลดความกว้าง */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.7); /* ปรับขนาดเงา */
            border: 3px solid #ff69b4;
        }

        .register-title {
            text-align: center;
            font-size: 1.8rem; /* ลดขนาดฟอนต์ */
            margin-bottom: 15px; /* ลดระยะห่าง */
            color: #ff69b4;
            font-family: 'Montserrat', sans-serif;
        }

        .input-group {
            margin-bottom: 15px; /* ลดระยะห่างระหว่างช่องกรอกข้อมูล */
        }

        label {
            display: block;
            font-size: 1rem;
            margin-bottom: 5px;
            color: white;
            font-weight: 500;
        }

        input {
            width: 100%;
            padding: 10px; /* ลดขนาด padding */
            font-size: 1rem;
            background-color: #444;
            color: white;
            border: 2px solid #555;
            border-radius: 5px;
            margin-bottom: 10px;
            transition: 0.3s ease;
        }

        input:focus {
            background-color: #555;
            border-color: #ff69b4;
            outline: none;
        }

        button {
            width: 100%;
            padding: 10px; /* ลดขนาด padding */
            font-size: 1.2rem;
            background-color: #ff69b4;
            border: none;
            border-radius: 5px;
            color: white;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.3s;
        }

        button:hover {
            background-color: #e2589e;
            transform: scale(1.05);
        }

        .back-to-login-container {
            text-align: center;
            margin-top: 10px;
        }

        .back-to-login {
            color: #ff69b4;
            text-decoration: none;
            font-weight: 500;
        }

        .back-to-login:hover {
            text-decoration: underline;
        }

        footer {
            text-align: center;
            padding: 20px;
            background-color: #222;
            border-top: 2px solid #ff69b4;
        }

        footer p {
            margin: 0;
            color: white;
            font-family: 'Montserrat', sans-serif;
        }

    </style>
</head>
<body>
    <header>
        <h1 class="logo">STORYTELLER</h1>
        <nav>
            <a href="/" class="nav-link">HOME</a>
            <a href="/genre" class="nav-link">GENRE</a>
        </nav>
    </header>

    <section class="register-form">
        <div class="register-container">
            <h2 class="register-title">Create an Account</h2>
            <form action="/register" method="POST">
                <div class="input-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" placeholder="Enter your username" required>
                </div>
                
                <div class="input-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email" required>
                </div>
                
                <div class="input-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required>
                </div>
                
                <div class="input-group">
                    <label for="confirm-password">Confirm Password</label>
                    <input type="password" id="confirm-password" name="confirm-password" placeholder="Confirm your password" required>
                </div>
                
                <button type="submit">Sign Up</button>
            </form>
            <div class="back-to-login-container">
                <p>Already have an account? <a href="/login" class="back-to-login">Back to Login</a></p>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; 2025 STORYTELLER</p>
    </footer>
</body>
</html>
